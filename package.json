{
  "name": "homebridge-keflsx",
  "displayName": "KEF LSX",
  "version": "1.0.0",
  "description": "Homebridge plugin for KEF LSX Gen 1 wireless speakers",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "keywords": [
